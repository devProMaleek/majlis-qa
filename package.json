{
  "name": "majlis-qa",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "supabase": "node scripts/supabase.mjs",
    "backend:start": "node scripts/supabase.mjs start",
    "backend:stop": "node scripts/supabase.mjs stop",
    "backend:env": "node scripts/local-backend-env.mjs",
    "db:migrate": "node scripts/supabase.mjs migration up",
    "db:types": "node scripts/supabase.mjs gen types typescript --schema public > src/lib/supabase/database.types.ts",
    "backend:seed": "node --env-file=.env.test.local --import tsx scripts/seed-local-backend.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:backend": "node --env-file=.env.test.local --import tsx --test --test-concurrency=1 tests/backend/*.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "shadcn": "^4.23.0",
    "supabase": "^3.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "@ts-morph/common": {
      "minimatch": "11.0.1"
    }
  }
}
