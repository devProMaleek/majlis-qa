# Design previews work without these. Staff sign-in requires both values.
# For isolated local development, run npm run backend:env instead of copying this file.
# For hosted environments, use separate development/staging/production projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use a publishable key (or a local legacy anon JWT), never an elevated key.
# The application has no service-role/secret-key requirement.
# Local test credentials are generated separately in ignored .env.test.local.
