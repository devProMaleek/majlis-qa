# The application-shell milestone runs without environment variables.
# Reserved for the next Supabase/authentication milestone. Not read by this app yet.
# Use separate development, preview/staging and production projects.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never expose a Supabase secret/service-role key through NEXT_PUBLIC_*.
